AEGIS_ENVIRONMENT=development
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
AEGIS_SQL_ECHO=false
AEGIS_INVESTIGATOR_PROVIDER=disabled
AEGIS_INVESTIGATOR_MAX_NARRATIVE_CHARS=2000
# Optional only for an externally injected provider; no key is required for normal operation.
AEGIS_OPENAI_API_KEY=
AEGIS_CORS_ALLOWED_ORIGINS=http://localhost:3000
AEGIS_DEMO_MODE=false
